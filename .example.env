# HTTP service
PORT=8000

# Optional API key. Leave empty to disable authentication.
# When set, clients must send: X-API-Key: <value>
IDREF_API_KEY=

# Public IdRef / Qualinka endpoints
FIND_RA_ENDPOINT=https://qualinka.idref.fr/data/find-ra-idref/api/v2/debug/req
ATTRRA_ENDPOINT=https://qualinka.idref.fr/data/attrra/api/v2/req
REFERENCES_ENDPOINT=https://www.idref.fr/services/references/{ppn}.json
IDREF_USER_AGENT=humatheque-idref-qualinka-api/0.1

# Request behavior
IDREF_HTTP_TIMEOUT=20.0
IDREF_MAX_RETRIES=2
IDREF_BACKOFF_BASE=1.0

# Alignment defaults
IDREF_MAX_CANDIDATES=20
IDREF_MAX_DOCS_PER_ROLE=20
IDREF_REFERENCE_TOP_K=3
IDREF_ACCEPT_THRESHOLD=0.65
IDREF_MARGIN_THRESHOLD=0.08

# Optional sentence-transformers model. Leave empty for lexical scoring.
# Example: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
IDREF_EMBEDDING_MODEL=

# Optional Hugging Face token, used to download the embedding model.
# Leave empty for public models / anonymous downloads.
HF_TOKEN=

# Score weights
DEFAULT_WEIGHT_NAME=0.40
DEFAULT_WEIGHT_ATTRRA_SOURCE=0.25
DEFAULT_WEIGHT_ATTRRA_NOTE=0.15
DEFAULT_WEIGHT_REFERENCES=0.15
DEFAULT_WEIGHT_INSTITUTION_YEAR=0.05

# Organization alignment (établissements de soutenance + écoles doctorales).
# The referential is built offline by idref_org_alignment/run_all.py.
IDREF_ORG_INDEX_PATH=idref_org_alignment/index_recherche.json
IDREF_ORG_SPARQL_ENDPOINT=https://data.idref.fr/sparql
IDREF_ORG_ACCEPT_THRESHOLD=0.72
IDREF_ORG_MARGIN_THRESHOLD=0.08
IDREF_ORG_LOW_THRESHOLD=0.45
IDREF_ORG_FLOOR_THRESHOLD=0.30
IDREF_ORG_MAX_CANDIDATES=5
